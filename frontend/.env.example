# Base URL of the ClaimPilot backend API.
#
# - Absolute URL (default): the browser calls the backend directly. The backend
#   must allow the Vite origin via CORS (`CORS_ALLOW_ORIGINS` in the backend
#   `.env`).
# - Empty string: requests are same-origin and go through the Vite dev proxy
#   (/api -> http://localhost:8000), which avoids the CORS requirement locally.
#
# Never put secrets or database credentials in frontend env vars; privileged
# access stays server-side.
VITE_API_BASE_URL=http://localhost:8000

# Optional shared bearer token sent as `Authorization: Bearer <token>` on every
# request. Set this only when the backend has `API_AUTH_TOKEN` configured.
#
# This is a shared service token, not an individual reviewer identity, and it is
# visible to anyone using the browser. Do not treat it as proof of who the user
# is; real per-reviewer authentication is a later change.
# VITE_API_TOKEN=
